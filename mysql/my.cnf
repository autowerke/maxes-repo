[mysqld]
# --- PERFORMANCE TUNING ---

# 1. InnoDB Buffer Pool (Paling Penting)
# Ini membuat Data & Index disimpan di RAM.
# Rule of thumb: 50-70% RAM tersedia. Kita kasih 4GB.
innodb_buffer_pool_size = 4G

# 2. Log File Size
# Ukuran log transaksi. Makin besar, makin jarang dia nulis ke disk.
innodb_log_file_size = 512M
innodb_log_buffer_size = 64M

# 3. Connections
# Maxes punya banyak client (PHP, Python AI, Tomcat BIRT, Navicat)
# Default 151 sering kurang. Kita naikkan.
max_connections = 500

# 4. IO Capacity
# Karena Ryzen 7 biasanya pakai SSD NVMe kencang, kita naikkan limit IO-nya.
innodb_io_capacity = 2000
innodb_io_capacity_max = 4000

# 5. Query Cache (Opsional untuk Read-Heavy)
query_cache_type = 1
query_cache_limit = 2M
query_cache_size = 64M

# 6. Character Set (Biar gak pusing encoding)
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci